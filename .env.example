# Work Station / DECIA — variáveis de ambiente. Copie para .env (ignorado pelo git) e preencha.
# Este arquivo traz SÓ NOMES e descrições; nunca coloque um valor real aqui. Em produção os valores vêm do cofre/secrets
# do orquestrador. Perfil: SPRING_PROFILES_ACTIVE=dev|test|prod (prod exige todos os marcados [obrigatório em prod]).
#
# Regra do arquivo: só as variáveis SEM valor padrão ficam descomentadas. As demais aparecem comentadas, com o padrão
# que o application.yml aplica: exportar `VAR=` vazio (ex.: `set -a; . ./.env; set +a`) faz o Spring tratar a variável
# como definida e o padrão `${VAR:...}` deixa de valer — a URL JDBC ficaria `jdbc:mysql://:/`. Descomente só o que mudar.

# ---- MySQL 8.4 (obrigatório em todo ambiente) ----
WS_DB_PASSWORD=                 # [obrigatório sempre] sem valor padrão: a API não sobe sem ela
WS_DB_ROOT_PASSWORD=            # [obrigatório no docker-compose.dev.yml] (porta presa em 127.0.0.1)
# WS_DB_HOST=localhost
# WS_DB_PORT=3306
# WS_DB_NAME=workstation
# WS_DB_USER=workstation
# WS_DB_SSL_MODE=PREFERRED      # PREFERRED (dev) | REQUIRED (prod, padrão do perfil prod)
# WS_DB_POOL_SIZE=10

# ---- JWT próprio RS256 (scripts/keys/generate_jwt_keys.sh grava em ./keys/, fora do git) ----
# Em prod é obrigatória UMA das formas por chave (D-24): caminho do arquivo OU conteúdo PEM na variável (o caminho tem precedência).
# WS_JWT_PRIVATE_KEY_PATH=      # [obrigatório em prod, ou o _PEM] caminho do PEM PKCS#8; só a API que emite tokens precisa
# WS_JWT_PUBLIC_KEY_PATH=       # [obrigatório em prod, ou o _PEM] caminho do PEM X.509 usado para validar
# WS_JWT_PRIVATE_KEY_PEM=       # alternativa: conteúdo do PEM (quebras de linha como \n) — nunca neste arquivo
# WS_JWT_PUBLIC_KEY_PEM=        # alternativa: conteúdo do PEM
# WS_JWT_ISSUER=work-station
# WS_JWT_AUDIENCE=work-station-api
# WS_JWT_ACCESS_TTL_MINUTES=15  # Q-49/D-25: 15 min até a resposta
# WS_REFRESH_TTL=30d            # refresh com "lembrar-me" (Q-30)
# WS_REFRESH_SHORT_TTL=24h      # refresh sem "lembrar-me"

# ---- Força bruta e IP do cliente (D-14) ----
# EDGE_PROXY_SECRET=            # HMAC-SHA256 do IP assinado pelo BFF (X-Ws-Client-Ip/-Proxy-Ts/-Proxy-Sig); >= 32 chars (openssl rand -hex 32); vazio desliga
# WS_EDGE_IP_HEADER=X-Real-IP   # cabeçalho único da borda; vazio desliga. X-Forwarded-For NUNCA é lido
# WS_TRUSTED_PROXIES=           # IPs/CIDRs da borda (vírgula): só vindo de um deles o cabeçalho acima é aceito; vazio = ignorado
# WS_AUTH_RATE_LIMIT_ENABLED=true
# WS_AUTH_HASH_CONCURRENCY=0    # 0 = max(1, min(max(2, núcleos), WS_DB_POOL_SIZE/2))
# WS_AUTH_HASH_WAIT_MS=2000     # espera por vaga no bulkhead antes do 503 AUTENTICACAO_OCUPADA

# ---- Primeira conta ADMIN (AdminBootstrap; só cria se não existe nenhum ADMIN) ----
# WS_ADMIN_BOOTSTRAP_ENABLED=false
# WS_ADMIN_EMAIL=
# WS_ADMIN_USERNAME=admin
# WS_ADMIN_INITIAL_PASSWORD=    # [obrigatório em prod quando o bootstrap está ligado] >= 16 chars; sem valor padrão; só usada na criação
# WS_ADMIN_PROMOTE_EXISTING=false   # true promove uma conta existente com o e-mail acima (só ativa e com e-mail confirmado)

# ---- Termos e privacidade (gancho do bloco LGPD A; gravados em users.terms_version/privacy_version) ----
# WS_LEGAL_TERMS_VERSION=1.0
# WS_LEGAL_PRIVACY_VERSION=1.0

# ---- E-mail transacional (Bloco 3: adaptador de LOG, sem SMTP; variáveis WS_SMTP_* reservadas para o adaptador real — Q-84) ----
# WS_MAIL_ECHO_BODY=false       # true só em dev: imprime o código/token no log local
# WS_SMTP_HOST=
# WS_SMTP_PORT=
# WS_SMTP_USERNAME=
# WS_SMTP_PASSWORD=
# WS_SMTP_FROM=

# ---- Login institucional OIDC (RF2.CA03; desligado por padrão) ----
# WS_OIDC_ENABLED=false
# WS_OIDC_ISSUER_URI=           # ex.: https://login.microsoftonline.com/<tenant>/v2.0 ou https://accounts.google.com
# WS_OIDC_CLIENT_ID=
# WS_OIDC_CLIENT_SECRET=        # usado pelo BFF na troca do código (PKCE); a API só valida o id_token
# WS_OIDC_PROVIDER_NAME=institucional

# ---- Criptografia de campos sensíveis (AES-GCM) e HMAC do email_hash ----
# WS_DATA_ENCRYPTION_KEY=       # [obrigatório em prod] base64 de 32 bytes aleatórios (openssl rand -base64 32); fora de prod ausente = chave efêmera (WARN)

# ---- Aplicação ----
# PORT=8080
# WS_APP_BASE_URL=http://localhost:8080
# WS_FRONTEND_URL=http://localhost:3000
# WS_CORS_ALLOWED_ORIGINS=http://localhost:3000   # lista separada por vírgula (origem do BFF Next.js)
# WS_API_DOCS_ENABLED=true      # false em prod (padrão do perfil)
# WS_MANAGEMENT_EXPOSURE=health,info   # health (prod) | health,info (dev)
# WS_SECRETS_ENFORCE=false      # true força a checagem dos segredos fora do perfil prod
# WS_LOG_LEVEL=INFO
# WS_LOG_LEVEL_APP=INFO
# WS_LOG_LEVEL_SQL=WARN

# ---- Stores opcionais (desligados por padrão; ARQUITETURA §3.2) ----
# WS_REDIS_ENABLED=false
# WS_REDIS_HOST=localhost
# WS_REDIS_PORT=6379
# WS_REDIS_USERNAME=
# WS_REDIS_PASSWORD=            # [obrigatório no docker-compose.dev.yml ao subir o redis]
# WS_REDIS_SSL=false
# WS_CASSANDRA_ENABLED=false
# WS_CASSANDRA_CONTACT_POINTS=localhost
# WS_CASSANDRA_PORT=9042
# WS_CASSANDRA_LOCAL_DATACENTER=datacenter1
# WS_CASSANDRA_KEYSPACE=workstation
# WS_CASSANDRA_USERNAME=
# WS_CASSANDRA_PASSWORD=
# WS_OPENSEARCH_ENABLED=false
# WS_OPENSEARCH_URL=http://localhost:9200
# WS_OPENSEARCH_USERNAME=
# WS_OPENSEARCH_PASSWORD=
# WS_STORAGE_TYPE=local         # local | s3
# WS_STORAGE_LOCAL_DIR=./data/media
# WS_S3_ENDPOINT=
# WS_S3_REGION=us-east-1
# WS_S3_BUCKET=workstation-media
# WS_S3_ACCESS_KEY_ID=          # [obrigatório no docker-compose.dev.yml ao subir o minio]
# WS_S3_SECRET_ACCESS_KEY=      # [obrigatório no docker-compose.dev.yml ao subir o minio]
# WS_PLATFORM_ENABLED=false

# ---- IA (RF43: desligada = só motor local) ----
# WS_AI_REMOTE_ENABLED=false
# WS_AI_REQUEST_TIMEOUT_SECONDS=30
# WS_ANTHROPIC_API_KEY=
# WS_GOOGLE_AI_API_KEY=

# ---- Frontend (Next.js) ----
# API_INTERNAL_URL=              # URL da API vista pelo servidor Next (BFF app/bff/auth); padrão: NEXT_PUBLIC_API_BASE_URL
# NEXT_PUBLIC_API_BASE_URL=     # URL pública da API (CSP connect-src); padrão do código: http://localhost:8080
# NEXT_TELEMETRY_DISABLED=1

# ---- CI / análise ----
# NVD_API_KEY=                  # OWASP Dependency-Check (mvn -Psecurity verify)
