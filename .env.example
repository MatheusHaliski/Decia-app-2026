# Work Station / DECIA — variáveis de ambiente. Copie para .env (ignorado pelo git) e preencha.
# Este arquivo traz SÓ NOMES e descrições; nunca coloque um valor real aqui. Em produção os valores vêm do cofre/secrets
# do orquestrador. Perfil: SPRING_PROFILES_ACTIVE=dev|test|prod (prod exige todos os marcados [obrigatório em prod]).

# ---- MySQL 8.4 (obrigatório em todo ambiente) ----
WS_DB_HOST=
WS_DB_PORT=
WS_DB_NAME=
WS_DB_USER=
WS_DB_PASSWORD=                 # [obrigatório sempre] sem valor padrão: a API não sobe sem ela
WS_DB_ROOT_PASSWORD=            # só o docker-compose.dev.yml (porta presa em 127.0.0.1)
WS_DB_SSL_MODE=                 # PREFERRED (dev) | REQUIRED (prod, padrão do perfil prod)
WS_DB_POOL_SIZE=

# ---- JWT próprio RS256 (scripts/keys/generate_jwt_keys.sh grava em ./keys/, fora do git) ----
WS_JWT_PRIVATE_KEY_PATH=        # [obrigatório em prod] caminho do PEM PKCS#8; só a API que emite tokens precisa
WS_JWT_PUBLIC_KEY_PATH=         # [obrigatório em prod] caminho do PEM X.509 usado para validar
WS_JWT_ISSUER=
WS_JWT_AUDIENCE=

# ---- Criptografia de campos sensíveis (AES-GCM, Bloco 2) ----
WS_DATA_ENCRYPTION_KEY=         # [obrigatório em prod] base64 de 32 bytes aleatórios (openssl rand -base64 32)

# ---- Aplicação ----
PORT=
WS_APP_BASE_URL=
WS_FRONTEND_URL=
WS_CORS_ALLOWED_ORIGINS=        # lista separada por vírgula (origem do BFF Next.js)
WS_API_DOCS_ENABLED=            # false em prod (padrão do perfil)
WS_MANAGEMENT_EXPOSURE=         # health (prod) | health,info (dev)
WS_SECRETS_ENFORCE=             # true força a checagem dos segredos fora do perfil prod
WS_LOG_LEVEL=
WS_LOG_LEVEL_APP=
WS_LOG_LEVEL_SQL=

# ---- Stores opcionais (desligados por padrão; ARQUITETURA §3.2) ----
WS_REDIS_ENABLED=
WS_REDIS_HOST=
WS_REDIS_PORT=
WS_REDIS_USERNAME=
WS_REDIS_PASSWORD=
WS_REDIS_SSL=
WS_CASSANDRA_ENABLED=
WS_CASSANDRA_CONTACT_POINTS=
WS_CASSANDRA_PORT=
WS_CASSANDRA_LOCAL_DATACENTER=
WS_CASSANDRA_KEYSPACE=
WS_CASSANDRA_USERNAME=
WS_CASSANDRA_PASSWORD=
WS_OPENSEARCH_ENABLED=
WS_OPENSEARCH_URL=
WS_OPENSEARCH_USERNAME=
WS_OPENSEARCH_PASSWORD=
WS_STORAGE_TYPE=                # local | s3
WS_STORAGE_LOCAL_DIR=
WS_S3_ENDPOINT=
WS_S3_REGION=
WS_S3_BUCKET=
WS_S3_ACCESS_KEY_ID=
WS_S3_SECRET_ACCESS_KEY=
WS_PLATFORM_ENABLED=

# ---- IA (RF43: desligada = só motor local) ----
WS_AI_REMOTE_ENABLED=
WS_AI_REQUEST_TIMEOUT_SECONDS=
WS_ANTHROPIC_API_KEY=
WS_GOOGLE_AI_API_KEY=

# ---- Frontend (Next.js) ----
NEXT_PUBLIC_API_BASE_URL=       # URL pública da API (CSP connect-src)
NEXT_TELEMETRY_DISABLED=

# ---- CI / análise ----
NVD_API_KEY=                    # OWASP Dependency-Check (mvn -Psecurity verify)
