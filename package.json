{
  "name": "work-station-web",
  "version": "0.1.0",
  "private": true,
  "description": "Frontend Next.js do Work Station / DECIA (SECID-PR) — consome a API Java em NEXT_PUBLIC_API_BASE_URL",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0 --ignore-pattern \"scripts/lint-fixtures/**\" && stylelint \"**/*.css\" --ignore-pattern \"node_modules/**\" --ignore-pattern \".next/**\" --ignore-pattern \"docs/**\" --ignore-pattern \"ws-*/**\" --ignore-pattern \"public/**\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "i18n:check": "node scripts/i18n/check.js --fail",
    "prebuild": "node scripts/i18n/check.js --fail",
    "e2e": "playwright test",
    "rf:catalog": "node scripts/rf/gerar-catalogo.mjs",
    "glyphs:sprite": "node scripts/glyphs/gerar-sprite.mjs",
    "brand:fundos": "node scripts/brand/gerar-fundos.mjs",
    "shell:capturas": "node scripts/shell/capturas.mjs",
    "api:types": "openapi-typescript contracts/openapi/openapi.json --output lib/api/schema.d.ts"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-radio-group": "1.4.7",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-toast": "1.2.23",
    "@radix-ui/react-tooltip": "1.2.16",
    "next": "^16.3.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@next/eslint-plugin-next": "^16.3.8",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "openapi-typescript": "7.13.0",
    "postcss": "^8.5.29",
    "stylelint": "^17.16.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "postcss": "^8.5.29"
  },
  "engines": {
    "node": ">=22"
  }
}
