<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>br.gov.pr.secid.workstation</groupId>
        <artifactId>work-station-api</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>ws-application</artifactId>
    <name>ws-application</name>
    <description>Casos de uso, portas, eventos de domínio, Guard e utilitários comuns (ApiException, Masking)</description>

    <properties>
        <!-- gate de cobertura (ARQUITETURA §3.4) ligado neste módulo -->
        <jacoco.check.skip>false</jacoco.check.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>br.gov.pr.secid.workstation</groupId>
            <artifactId>ws-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
        </dependency>
        <dependency>
            <!-- @ConditionalOnProperty dos adaptadores em memória (fallback quando ws.redis.enabled=false) -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.data</groupId>
            <artifactId>spring-data-commons</artifactId>
        </dependency>
        <dependency>
            <!-- Jackson 3 (Boot 4): pacote tools.jackson; java.time já vem no databind -->
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <!-- plugin do ImageIO para ler WEBP ao reprocessar a foto de perfil (registrado por ServiceLoader) -->
        <dependency>
            <groupId>com.twelvemonkeys.imageio</groupId>
            <artifactId>imageio-webp</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
