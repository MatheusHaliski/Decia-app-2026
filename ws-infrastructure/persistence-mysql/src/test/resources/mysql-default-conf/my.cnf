# Configuração do MySQL dos testes (Testcontainers monta este diretório do classpath em /etc/mysql/conf.d — sobrepõe o my.cnf
# padrão que vem no jar testcontainers-mysql; valores abaixo copiados dele, para contêineres pequenos).
#
# log_bin_trust_function_creators = 1: a V72 cria gatilhos (audit_log append-only) com o usuário da aplicação, que não tem SUPER.
# Com o binlog ligado (padrão do MySQL 8.4) o servidor recusa CREATE TRIGGER sem SUPER (erro 1419) a menos que esta variável
# esteja ligada — exatamente como em produção e no docker-compose.dev.yml (docs/arquitetura/seguranca-audit-log.md).
[mysqld]
user = mysql
datadir = /var/lib/mysql
port = 3306
skip-external-locking
key_buffer_size = 16K
max_allowed_packet = 1M
table_open_cache = 4
sort_buffer_size = 64K
read_buffer_size = 256K
read_rnd_buffer_size = 256K
net_buffer_length = 2K
host_cache_size = 0
skip-name-resolve
innodb_data_file_path = ibdata1:10M:autoextend
innodb_buffer_pool_size = 16M
innodb_log_buffer_size = 8M
innodb_flush_log_at_trx_commit = 1
innodb_lock_wait_timeout = 50
log_bin_trust_function_creators = 1
