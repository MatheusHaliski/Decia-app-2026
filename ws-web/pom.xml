<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>br.gov.pr.secid.workstation</groupId>
        <artifactId>work-station-api</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>ws-web</artifactId>
    <name>ws-web</name>
    <description>Controllers REST por RF, Spring Security (OAuth2 Resource Server), GlobalExceptionHandler, filtros, springdoc</description>

    <properties>
        <!-- gate de cobertura (ARQUITETURA §3.4) ligado neste módulo -->
        <jacoco.check.skip>false</jacoco.check.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>br.gov.pr.secid.workstation</groupId>
            <artifactId>ws-application</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
        <dependency>
            <!-- Argon2id (RF1.CA07): o Argon2PasswordEncoder do spring-security-crypto delega ao Bouncy Castle -->
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Boot 4: @WebMvcTest e MockMvc saíram do spring-boot-starter-test para o starter do módulo -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Boot 4: traz o spring-security-test e põe a segurança de volta nas fatias @WebMvcTest -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
